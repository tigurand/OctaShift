<Window x:Class="OctaShift.AdvancedSimplifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Per-Track Limit Simultaneous Notes"
        Height="540"
        Width="880"
        MinHeight="440"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Limit simultaneous notes per track"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <Button Content="💡"
                    Width="26"
                    Height="26"
                    Margin="8,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Cursor="Help"
                    ToolTipService.ShowDuration="60000">
                <Button.ToolTip>
                    <TextBlock MaxWidth="460"
                               TextWrapping="Wrap"
                               Text="Choose how notes that start at the exact same time are limited inside each track.&#10;&#10;Default: keeps the usual low/middle/high spread.&#10;Lowest: keeps the lowest notes (e.g. power chords).&#10;Highest: keeps the top notes.&#10;Exclude: drops every note of this track.&#10;&#10;This is applied per track before tracks are merged, so every other conversion option still applies afterwards. Percussion tracks are ignored. In the combined view, rules are stored by track name and apply to every queued file that has a track with that name; unnamed tracks must be configured per file." />
                </Button.ToolTip>
            </Button>
        </StackPanel>

        <StackPanel x:Name="FileSelectorPanel"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <TextBlock Text="View:" VerticalAlignment="Center" />
            <ComboBox x:Name="FileCombo"
                      Width="430"
                      Margin="8,0,0,0"
                      VerticalContentAlignment="Center"
                      SelectionChanged="FileCombo_SelectionChanged" />
        </StackPanel>

        <DataGrid x:Name="TracksGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Track"
                                    Binding="{Binding DisplayName}"
                                    IsReadOnly="True"
                                    Width="*" />

                <DataGridTextColumn Header="Files"
                                    Binding="{Binding FilesText}"
                                    IsReadOnly="True"
                                    Width="90" />

                <DataGridTextColumn Header="Channels"
                                    Binding="{Binding Channels}"
                                    IsReadOnly="True"
                                    Width="80" />

                <DataGridTextColumn Header="Max simultaneous"
                                    Binding="{Binding MaxSimultaneous}"
                                    IsReadOnly="True"
                                    Width="120" />

                <DataGridComboBoxColumn x:Name="StrategyColumn"
                                        Header="Strategy"
                                        Width="120"
                                        SelectedItemBinding="{Binding Strategy, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTemplateColumn Header="Notes max" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsLimitEnabled}"
                                     Margin="2"
                                     VerticalContentAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,8,0,0">
            <Button Content="All Default"
                    Width="100"
                    Margin="0,0,6,0"
                    Click="AllDefault_Click" />

            <Button Content="All Off"
                    Width="80"
                    Margin="0,0,18,0"
                    Click="AllOff_Click" />

            <TextBlock Text="Tracks not listed:"
                       VerticalAlignment="Center" />

            <ComboBox x:Name="UnmatchedCombo"
                      Width="125"
                      Margin="6,0,0,0"
                      VerticalContentAlignment="Center"
                      SelectionChanged="UnmatchedCombo_SelectionChanged" />

            <TextBlock x:Name="SkippedTracksText"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="Gray" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="OK"
                    Width="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Ok_Click" />

            <Button Content="Cancel"
                    Width="90"
                    IsCancel="True"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
